# Le graphe de dependances d'Amplify Gen 2 (aws-cdk-lib, zod, constructs)
# comporte des conflits de peer dependencies que npm 7+ refuse par defaut.
# Ce reglage doit valoir aussi bien en local qu'au build Amplify, sinon
# `npm install` et `npm ci` produisent des arbres differents et le lockfile
# se desynchronise — c'est ce qui a fait echouer le build #2.
legacy-peer-deps=true
